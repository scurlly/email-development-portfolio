        <mj-image src="https://bucket.mlcdn.com/a/750/750358/images/58e239247f9f36b6f387693994e41793740e74f1.png" width="80px" padding-top="30px" />

      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
