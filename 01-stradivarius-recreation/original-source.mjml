    <mj-section background-color="#ffffff" padding-bottom="40px">
      <mj-column padding="0">

        <mj-text mj-class="footer-small" padding-bottom="15px">
          If you cannot see this email correctly, <a href="#" style="color: #9D9D9C; text-decoration: underline;">click here.</a>
