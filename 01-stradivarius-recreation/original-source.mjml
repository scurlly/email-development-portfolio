<mjml>
  <mj-head>
    <mj-attributes>
      <mj-all font-family="Arial, Helvetica, sans-serif" color="#000000" />

      <mj-text line-height="1.4" font-size="14px" />

      <mj-button font-weight="600" font-size="20px" border-radius="0px" inner-padding="15px 25px" />
      <mj-class name="footer-small" color=' #9D9D9C' font-family=' Arial, Helvetica, sans-serif' font-size=' 9px' text-align='left' />
    </mj-attributes>
    <mj-style>
      /* Mobile-Specific Overrides */
      @media only screen and (max-width:480px) {
      /* Shrink Huge Sale Titles */
      .m-title h2 {
      font-size: 34px !important;
      line-height: 1.1 !important;
      }
      /* Scale down medium headers */
      .m-header p {
      font-size: 16px !important;
      }
      /* Adjust Button Text Size */
      .m-button b {
      font-size: 16px !important;
      line-height: 28px !important;
      }
      /* Center everything on mobile for better thumb-reach */
      .m-center div {
      text-align: center !important;
      }
      .m-app-download div {
      font-size: 14px !important;
      }
    </mj-style>
  </mj-head>
  <mj-body>
    <mj-section background-color='#D52234' padding-bottom='0'>
      <mj-column padding='0' width='100%'>

        <mj-text align='center'>
          <p style='color: #ffffff;font-family:  Arial, Helvetica, sans-serif;font-size: 14px;line-height: 20px;text-align: center;padding:0;margin:0;font-weight: 700;'>
            Register on our app and get 10% off your first order
          </p>
        </mj-text>

        <mj-image padding='0' src='https://messages.stradivarius.com/assets/responsysimages/industria004/contentlibrary/campaigns/2025/rebajas_aw25/07.bestof/images/logo_rebajasaw_rojo.jpg' align='center'></mj-image>

      </mj-column>

      <mj-image src='https://messages.stradivarius.com/assets/responsysimages/industria004/contentlibrary/campaigns/2025/rebajas_aw25/07.bestof/images/image_1.jpg' padding='0'></mj-image></mj-section>
