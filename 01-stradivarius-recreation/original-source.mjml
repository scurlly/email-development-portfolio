        <mj-button css-class="m-button" background-color='#D52234' border-radius='0' width='100%'><b style="color:#ffffff;font-family:  Arial, sans-serif;font-size:20px;line-height:35px;text-transform: uppercase;font-weight:600; padding:0;">GRAB IT!</b></mj-button>

